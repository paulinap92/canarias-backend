# Optional external API keys
AEMET_API_KEY=

# Local server
PORT=8000
INTERNAL_API_BASE=http://127.0.0.1:8000

# Optional cache location. If omitted, data/cache is used.
CACHE_DIR=
RAILWAY_VOLUME_MOUNT_PATH=


# TEMPORARY DEV-ONLY image previews.
# 1 = allow images discovered on external source pages/RSS.
# 0 = use only explicitly curated/licensed image_url values.
CANARIAS_DEV_REMOTE_IMAGES=1


# Local/internal editorial UI. Disabled by default.
# Set to 1 locally to open http://127.0.0.1:8000/editor
CANARIAS_CONTENT_EDITOR=0

# Required when the editor is accessed from a non-localhost client.
# Keep empty for localhost-only development.
CANARIAS_CONTENT_EDITOR_TOKEN=

# Optional editor-only override, useful for tests/sandboxes.
# Defaults to data/guide/content.
CANARIAS_CONTENT_ROOT=

# Future Cloudflare R2 media upload configuration.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
